// The value-by-value comparison against numpy.
//
// The cases themselves are in `vectors_data_wbtest.mbt`, generated by
// `scripts/gen_vectors.py`: the same inputs, run through numpy in this
// precision. What follows applies each operation to those inputs and compares
// the answer.
//
// Element-wise arithmetic is compared in units of the last place — the number of
// representable numbers between the two results — because that is what "the same
// answer" means for a floating-point computation, and it does not change with
// the magnitude of the numbers involved. Anything that goes through an
// algorithm of its own, like an inverse, is compared by relative error instead:
// the two implementations add up the same products in a different order, and how
// far that drifts depends on the conditioning of the matrix.

///|
/// How many representable numbers lie between `a` and `b`.
///
/// The bit patterns of positive floats are ordered like the numbers, so the
/// difference of the patterns counts the steps. Two numbers of different signs
/// are as far apart as it gets.
fn ulp_gap(a : Double, b : Double) -> Int64 {
  if a == b {
    return 0
  }
  if a.is_nan() || b.is_nan() {
    return 0x7FFFFFFFFFFFFFFF
  }
  let ia : Int64 = a.reinterpret_as_int64()
  let ib : Int64 = b.reinterpret_as_int64()
  if (ia < 0) != (ib < 0) {
    return 0x7FFFFFFFFFFFFFFF
  }
  (ia - ib).abs()
}

///|
/// Whether two results are the same to within `gap` units of the last place,
/// component by component.
fn same(a : FixedArray[Double], b : FixedArray[Double], gap : Int64) -> Bool {
  guard a.length() == b.length() else { return false }
  for i in 0..<a.length() {
    if ulp_gap(a[i], b[i]) > gap {
      return false
    }
  }
  true
}

///|
/// Whether `a` and `b` agree to `eps` of their own magnitude.
fn relatively_close(a : Double, b : Double, eps : Double) -> Bool {
  let one : Double = 1.0
  let scale = a.abs().max(b.abs()).max(one)
  (a - b).abs() <= eps * scale
}

///|
/// Whether two results agree to `eps` of their own magnitude, component by
/// component.
fn relatively_close_all(
  a : FixedArray[Double],
  b : FixedArray[Double],
  eps : Double,
) -> Bool {
  guard a.length() == b.length() else { return false }
  for i in 0..<a.length() {
    if !relatively_close(a[i], b[i], eps) {
      return false
    }
  }
  true
}

///|
/// Whether two results agree to `eps` of the size of the terms that produced
/// them.
///
/// A product sums terms that may be much larger than the result, and the
/// rounding error follows the terms, not the answer: a dot product that cancels
/// down to zero still carries the error of the numbers it cancelled. Comparing
/// against the size of the terms is the comparison that stays meaningful when
/// that happens.
fn close_to_terms(
  got : FixedArray[Double],
  want : FixedArray[Double],
  terms : Double,
  eps : Double,
) -> Bool {
  guard got.length() == want.length() else { return false }
  for i in 0..<got.length() {
    if (got[i] - want[i]).abs() > eps * terms {
      return false
    }
  }
  true
}

///|
test "vector arithmetic matches numpy" {
  for case in vec2_binary {
    let (a, b, sum, difference, product, quotient) = case
    assert_true(same((a + b).to_array(), sum.to_array(), 4))
    assert_true(same((a - b).to_array(), difference.to_array(), 4))
    assert_true(same((a * b).to_array(), product.to_array(), 4))
    assert_true(same((a / b).to_array(), quotient.to_array(), 4))
  }
  for case in vec3_binary {
    let (a, b, sum, difference, product, quotient) = case
    assert_true(same((a + b).to_array(), sum.to_array(), 4))
    assert_true(same((a - b).to_array(), difference.to_array(), 4))
    assert_true(same((a * b).to_array(), product.to_array(), 4))
    assert_true(same((a / b).to_array(), quotient.to_array(), 4))
  }
  for case in vec4_binary {
    let (a, b, sum, difference, product, quotient) = case
    assert_true(same((a + b).to_array(), sum.to_array(), 4))
    assert_true(same((a - b).to_array(), difference.to_array(), 4))
    assert_true(same((a * b).to_array(), product.to_array(), 4))
    assert_true(same((a / b).to_array(), quotient.to_array(), 4))
  }
}

///|
test "dot products match numpy" {
  for case in vec2_dot {
    let (a, b, expected) = case
    assert_true(ulp_gap(a.dot(b), expected) <= 4)
  }
  for case in vec3_dot {
    let (a, b, expected) = case
    assert_true(ulp_gap(a.dot(b), expected) <= 4)
  }
  for case in vec4_dot {
    let (a, b, expected) = case
    assert_true(ulp_gap(a.dot(b), expected) <= 4)
  }
}

///|
test "lengths and normalized vectors match numpy" {
  for case in vec2_metrics {
    let (v, length, squared, unit) = case
    assert_true(ulp_gap(v.length(), length) <= 4)
    assert_true(ulp_gap(v.length_squared(), squared) <= 4)
    assert_true(same(v.normalize().to_array(), unit.to_array(), 4))
  }
  for case in vec3_metrics {
    let (v, length, squared, unit) = case
    assert_true(ulp_gap(v.length(), length) <= 4)
    assert_true(ulp_gap(v.length_squared(), squared) <= 4)
    assert_true(same(v.normalize().to_array(), unit.to_array(), 4))
  }
  for case in vec4_metrics {
    let (v, length, squared, unit) = case
    assert_true(ulp_gap(v.length(), length) <= 4)
    assert_true(ulp_gap(v.length_squared(), squared) <= 4)
    assert_true(same(v.normalize().to_array(), unit.to_array(), 4))
  }
}

///|
test "rounding a vector matches numpy" {
  for case in vec2_rounding {
    let (v, absolute, floored, ceiled, rounded, fractional) = case
    assert_true(same(v.abs().to_array(), absolute.to_array(), 0))
    assert_true(same(v.floor().to_array(), floored.to_array(), 0))
    assert_true(same(v.ceil().to_array(), ceiled.to_array(), 0))
    assert_true(same(v.round().to_array(), rounded.to_array(), 1))
    assert_true(same(v.fract().to_array(), fractional.to_array(), 4))
  }
  for case in vec3_rounding {
    let (v, absolute, floored, ceiled, rounded, fractional) = case
    assert_true(same(v.abs().to_array(), absolute.to_array(), 0))
    assert_true(same(v.floor().to_array(), floored.to_array(), 0))
    assert_true(same(v.ceil().to_array(), ceiled.to_array(), 0))
    assert_true(same(v.round().to_array(), rounded.to_array(), 1))
    assert_true(same(v.fract().to_array(), fractional.to_array(), 4))
  }
  for case in vec4_rounding {
    let (v, absolute, floored, ceiled, rounded, fractional) = case
    assert_true(same(v.abs().to_array(), absolute.to_array(), 0))
    assert_true(same(v.floor().to_array(), floored.to_array(), 0))
    assert_true(same(v.ceil().to_array(), ceiled.to_array(), 0))
    assert_true(same(v.round().to_array(), rounded.to_array(), 1))
    assert_true(same(v.fract().to_array(), fractional.to_array(), 4))
  }
}

///|
test "interpolation matches numpy" {
  for case in vec3_lerp {
    let (a, b, t, expected) = case
    assert_true(same(a.lerp(b, t).to_array(), expected.to_array(), 4))
  }
}

///|
test "cross products match numpy" {
  for case in vec3_cross {
    let (a, b, expected) = case
    assert_true(same(a.cross(b).to_array(), expected.to_array(), 4))
  }
  for case in vec2_cross {
    let (a, b, cross, angle) = case
    assert_true(ulp_gap(a.cross(b), cross) <= 4)
    assert_true(ulp_gap(a.angle_between(b), angle) <= 8)
  }
}

///|
test "angles between vectors match numpy" {
  for case in vec3_angle {
    let (a, b, expected) = case
    assert_true(ulp_gap(a.angle_between(b), expected) <= 32)
  }
}

///|
test "projection and rejection match numpy" {
  for case in vec3_projection {
    let (v, onto, projected, rejected) = case
    assert_true(same(v.project(onto).to_array(), projected.to_array(), 4))
    assert_true(same(v.reject(onto).to_array(), rejected.to_array(), 4))
  }
}

///|
test "reflection matches numpy" {
  for case in vec3_reflection {
    let (incident, normal, expected) = case
    assert_true(
      same(incident.reflect(normal).to_array(), expected.to_array(), 4),
    )
  }
}

///|
test "matrix products match numpy" {
  for case in mat2_product {
    let (a, b, expected, terms) = case
    assert_true(
      close_to_terms((a * b).to_array(), expected.to_array(), terms, 1.0e-14),
    )
  }
  for case in mat3_product {
    let (a, b, expected, terms) = case
    assert_true(
      close_to_terms((a * b).to_array(), expected.to_array(), terms, 1.0e-14),
    )
  }
  for case in mat4_product {
    let (a, b, expected, terms) = case
    assert_true(
      close_to_terms((a * b).to_array(), expected.to_array(), terms, 1.0e-14),
    )
  }
}

///|
test "matrix and vector products match numpy" {
  for case in mat2_vector {
    let (m, v, expected, terms) = case
    assert_true(
      close_to_terms(
        m.mul_vec2(v).to_array(),
        expected.to_array(),
        terms,
        1.0e-14,
      ),
    )
  }
  for case in mat3_vector {
    let (m, v, expected, terms) = case
    assert_true(
      close_to_terms(
        m.mul_vec3(v).to_array(),
        expected.to_array(),
        terms,
        1.0e-14,
      ),
    )
  }
  for case in mat4_vector {
    let (m, v, expected, terms) = case
    assert_true(
      close_to_terms(
        m.mul_vec4(v).to_array(),
        expected.to_array(),
        terms,
        1.0e-14,
      ),
    )
  }
}

///|
test "transposes match numpy" {
  for case in mat2_transpose {
    let (m, expected) = case
    assert_true(same(m.transpose().to_array(), expected.to_array(), 0))
  }
  for case in mat3_transpose {
    let (m, expected) = case
    assert_true(same(m.transpose().to_array(), expected.to_array(), 0))
  }
  for case in mat4_transpose {
    let (m, expected) = case
    assert_true(same(m.transpose().to_array(), expected.to_array(), 0))
  }
}

///|
test "determinants match numpy" {
  for case in mat2_determinant {
    let (m, expected) = case
    assert_true(relatively_close(m.determinant(), expected, 1.0e-11))
  }
  for case in mat3_determinant {
    let (m, expected) = case
    assert_true(relatively_close(m.determinant(), expected, 1.0e-11))
  }
  for case in mat4_determinant {
    let (m, expected) = case
    assert_true(relatively_close(m.determinant(), expected, 1.0e-11))
  }
}

///|
test "inverses match numpy" {
  for case in mat2_inverse {
    let (m, expected) = case
    let inverse = m.inverse().unwrap()
    assert_true(
      relatively_close_all(inverse.to_array(), expected.to_array(), 1.0e-11),
    )
  }
  for case in mat3_inverse {
    let (m, expected) = case
    let inverse = m.inverse().unwrap()
    assert_true(
      relatively_close_all(inverse.to_array(), expected.to_array(), 1.0e-11),
    )
  }
  for case in mat4_inverse {
    let (m, expected) = case
    let inverse = m.inverse().unwrap()
    assert_true(
      relatively_close_all(inverse.to_array(), expected.to_array(), 1.0e-11),
    )
  }
}

///|
test "quaternions from an axis and an angle match numpy" {
  for case in quat_axis_angle {
    let (axis, angle, expected) = case
    let q = Quat::from_axis_angle(axis, angle)
    assert_true(same(q.to_array(), expected.to_array(), 4))
  }
}

///|
test "quaternion rotation matches numpy" {
  for case in quat_rotation {
    let (q, v, expected) = case
    assert_true(same(q.rotate(v).to_array(), expected.to_array(), 8))
  }
}

///|
test "quaternion to matrix matches numpy" {
  for case in quat_matrix {
    let (q, expected) = case
    assert_true(same(q.to_mat3().to_array(), expected.to_array(), 4))
  }
}

///|
test "slerp matches numpy" {
  for case in quat_slerp {
    let (a, b, t, expected) = case
    assert_true(same(a.slerp(b, t).to_array(), expected.to_array(), 4))
  }
}

///|
test "rotation between two directions matches numpy" {
  for case in quat_arc {
    let (from, to, expected) = case
    assert_true(Quat::from_rotation_arc(from, to).approx(expected, eps=1.0e-4))
  }
}

///|
test "affine transforms match numpy" {
  for case in affine3_apply {
    let (linear, offset, point, moved, turned, terms) = case
    let transform = Affine3::new(linear, offset)
    assert_true(
      close_to_terms(
        transform.transform_point(point).to_array(),
        moved.to_array(),
        terms,
        1.0e-14,
      ),
    )
    assert_true(
      close_to_terms(
        transform.transform_vector(point).to_array(),
        turned.to_array(),
        terms,
        1.0e-14,
      ),
    )
  }
}
