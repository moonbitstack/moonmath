// The special-function algorithms once, over an explicit `Ops[T]` algebra, so
// the same body serves `Double` and `moonnum`'s arbitrary-precision `Fixed`.
// The record is the seam: adding a number type means writing one `Ops` value,
// and every algorithm written against it follows.
import {
  "moonbitstack/moonnum",
  "moonbitlang/core/math",
}
