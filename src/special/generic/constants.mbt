///|
/// How many even Bernoulli numbers the table carries.
let bernoulli_count : Int32 = 80

///|
/// The table, parsed once into values of `T` by whoever builds an `Ops`.
///
/// It is parsed here rather than at each use because a Stirling expansion reads
/// a term per correction and a Bessel series reads a digamma per term, and
/// re-parsing eighty decimal strings inside that loop costs more than every
/// arithmetic step put together.
fn[T] parse_bernoulli(ops_from_decimal : (String) -> T) -> (Int32) -> T {
  // Filled on demand: a double needs a dozen of them and a hundred-digit run the
  // whole table, and building all eighty up front charges every caller for the
  // widest one. A column that has been read stays read, so the cost is one parse
  // per number per `Ops` value.
  let table : Array[T?] = Array::make(bernoulli_count, None)
  fn(k) {
    match table[k - 1] {
      Some(value) => value
      None => {
        let value = ops_from_decimal(bernoulli_text[k - 1])
        table[k - 1] = Some(value)
        value
      }
    }
  }
}

///|
/// Where a Stirling expansion starts: the argument is raised to this value
/// before the asymptotic series is used, and the extra logarithms are removed
/// afterwards with the recurrence.
///
/// The series is asymptotic, so its best truncation moves out with the argument,
/// and the argument therefore moves out with the width: `digits + 20` keeps the
/// first omitted term below the last digit the width holds, and every further
/// digit of shift costs another logarithm on the way up.
fn stirling_shift(digits : Int32) -> Int32 {
  if digits < 20 {
    20
  } else {
    digits + 20
  }
}

///|
/// How many Bernoulli terms the Stirling expansion keeps at this width.
fn stirling_terms(digits : Int32) -> Int32 {
  if digits < 20 {
    12
  } else if digits < 60 {
    40
  } else {
    80
  }
}
