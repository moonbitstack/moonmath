// Special functions at double precision: the gamma and error families, the
// Bessel functions, the elliptic integrals, the hypergeometric functions and the
// Riemann zeta.
//
// Every body lives in `special/generic`, written once against an `Ops` algebra,
// and this package is the double-precision face of it: each function here is the
// same one the arbitrary-precision package answers, handed `double_ops`. Keeping
// the two precisions on one body is what stops them from drifting apart.
import {
  "moonbitstack/moonmath/special/generic",
}
