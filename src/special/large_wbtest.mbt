///|
test "the confluent hypergeometric, large parameters" {
  for (a, b, x, want) in cases {
    let got = hyper1f1(a, b, x)
    if got != got || (got - want).abs() > 1.0e-11 * want.abs() {
      abort("hyper1f1(\{a}, \{b}, \{x}): got \{got} want \{want}")
    }
  }
}
