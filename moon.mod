name = "moonbitstack/moonmath"

version = "0.1.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmath"

license = "Apache-2.0"

keywords = [
  "math",
  "linear-algebra",
  "vector",
  "vec2",
  "vec3",
  "vec4",
  "matrix",
  "mat3",
  "mat4",
  "quaternion",
  "dual-quaternion",
  "skinning",
  "tangent-frame",
  "geometry",
  "transform",
  "graphics",
  "3d",
  "gamedev",
  "column-major",
  "wgsl",
  "webgpu",
  "gpu",
  "glm",
  "half-precision",
  "euler-angles",
  "shear",
  "color",
  "interval",
  "random-sampling",
  "special-functions",
  "gamma",
  "bessel",
  "hypergeometric",
  "elliptic-integral",
  "zeta",
  "arbitrary-precision",
  "moonbit",
]

description = "Vectors, matrices, quaternions and geometry for MoonBit: column-major, right-handed, and ready to copy into a GPU buffer, with a special-function subpackage in double and arbitrary precision."

import {
  "moonbitstack/moonnum@0.2.7",
}

source = "src"
